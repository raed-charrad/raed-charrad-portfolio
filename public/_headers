# Read from the published directory by both Cloudflare Pages and Netlify.

# Vite fingerprints these filenames, so a changed file gets a new name and this
# can be cached hard and forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/portrait.jpg
  Cache-Control: public, max-age=604800

# index.html must never be cached hard, or visitors keep an old page that points
# at asset filenames which no longer exist.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
